                        audio_file = asyncio.run(generate_speech(docent_script, final_row['?쒓뎔援?], final_row['?꾨줈紐?], selected_lang))
                            save_docent_cache(final_row['?쒓뎔援?], final_row['?꾨줈紐?], selected_lang, docent_script, audio_file)
